# ===== 服务基础配置 =====
# 服务监听端口
PORT=3000
# 公网 HTTPS 地址：微信 / 支付宝的异步回调(notify)必须能打到你的服务器。
# 本地开发可用内网穿透(ngrok/cloudflared)或 CloudStudio 沙箱的公网地址临时顶替。
PUBLIC_BASE_URL=https://your-public-host.example.com

# ===== Supabase（复用你现有的项目即可）=====
# 用于写入订单、查询订单状态、支付成功回写。
SUPABASE_URL=https://YOUR.supabase.co
SUPABASE_ANON_KEY=your_anon_key
# 服务端写入用 service_role key（切勿暴露给前端）
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ===== 微信支付 v3（H5 / MWEB）=====
WECHAT_ENABLED=false
WECHAT_SANDBOX=true
WECHAT_MCH_ID=your_mch_id
WECHAT_APP_ID=your_appid
WECHAT_API_V3_KEY=your_32byte_apiv3_key
WECHAT_SERIAL_NO=your_cert_serial_no
# 商户 API 私钥（apiclient_key.pem 内容，保留换行，可用 \n 转义）
WECHAT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# 微信支付平台证书公钥（用于验签回调，PEM 内容）
WECHAT_PLATFORM_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# ===== 支付宝（手机网站支付 wap）=====
ALIPAY_ENABLED=false
ALIPAY_SANDBOX=true
ALIPAY_APP_ID=your_appid
# 应用私钥（alipay 开放平台生成的 RSA2 私钥）
ALIPAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# 支付宝公钥（用于验签异步通知）
ALIPAY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# 前端从哪个源可以调用接口（CORS），逗号分隔；留空表示允许所有
ALLOWED_ORIGINS=

# ===== 后端接口鉴权 =====
# 设置一个随机长字符串；设置后前端需在「设置→真实支付」里填入相同密钥，
# 否则 create/query/仿真支付接口返回 401。公网/真实部署务必设置。
API_KEY=
# 沙箱模拟收银台开关：正式环境设为 false 关闭仿真支付（禁用心之后仿真接口返回 403）
SIMULATOR_ENABLED=true

